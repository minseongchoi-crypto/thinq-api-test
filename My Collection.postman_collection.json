  "item": [
    {
      "name": "가전 목록 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();\r\nvar fridge = jsonData.response.find(d => d.deviceType === \"DEVICE_REFRIGERATOR\");\r\n\r\nif (fridge) {\r\n    pm.collectionVariables.set(\"my_device_id\", fridge.deviceId);\r\n    pm.environment.set(\"my_device_id\", fridge.deviceId);\r\n    pm.globals.set(\"my_device_id\", fridge.deviceId);\r\n}\r\n\r\npm.test(\"가전 목록 정상 수신\", function () {\r\n    pm.response.to.have.status(200);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{thinq_pat}}"
          },
          {
            "key": "x-api-key",
            "value": "v6GFvkweNo7DK7yD3ylIZ9w52aKBU0eJ7wLXkSR3"
          },
          {
            "key": "x-country",
            "value": "KR"
          },
          {
            "key": "x-client-id",
            "value": "gemini-postman-client-id"
          },
          {
            "key": "x-message-id",
            "value": "{{my_message_id}}"
          },
          {
            "key": "x-service-phase",
            "value": "OP"
          }
        ],
        "url": {
          "raw": "{{thinq_url}}/devices",
          "host": [
            "{{thinq_url}}"
          ],
          "path": [
            "devices"
          ]
        }
      },
      "response": []
    },
